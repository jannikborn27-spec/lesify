# Vorlage. Pro Umgebung als .env anlegen (local) bzw. im Secret-Store von
# staging / production hinterlegen. Echte Werte NIE committen.
#
# local / staging / production haben jeweils EIGENE DB, EIGENEN Storage-Bucket
# und EIGENE Secrets.

# --- KI (Claude API) ---
# Phase 6 optional: fehlt der Key, läuft der deterministische FakeKiClient
# (kein echter Call/Kosten) — Details + weitere KI_*-Variablen in
# api/.env.example. Budget-Cap setzen, bevor der Key hier rein darf.
ANTHROPIC_API_KEY=

# --- Datenbank: Supabase Postgres, EU-Region ---
# DATABASE_URL = Transaction Pooler (Port 6543, ?pgbouncer=true) — Laufzeit
# DIRECT_URL   = Direct/Session-Verbindung (Port 5432) — nur Migrationen
# Fertige Strings: Supabase-Dashboard → "Connect" → Tab "ORMs"/"Prisma".
# Für die API gehören diese Werte in api/.env (siehe api/.env.example).
DATABASE_URL=
DIRECT_URL=

# --- Supabase Storage (Datei-Uploads, signierte URLs) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lesify-local

# --- Stripe ---
# Phase 9 optional: fehlt der Secret Key, nutzt die API den deterministischen
# FakeZahlungsGateway (kein echter Zahlungsverkehr). Echtes Adapter: Phase 16.
# Ist STRIPE_WEBHOOK_SECRET gesetzt, prüft /abo/webhook den stripe-signature-Header.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- API ---
NODE_ENV=development
PORT=3000
SESSION_SECRET=

# --- E-Mail: zurückgestellt (Phase 0 / backend-planning.md §8) ---
# EMAIL_API_KEY=
