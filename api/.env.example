# api/.env  — lokale Werte, NIE committen (steht in .gitignore).
# Vorlage: cp api/.env.example api/.env  und ausfüllen.
#
# --- Datenbank (Supabase) ---
# Im Supabase-Dashboard: "Connect" (oben) → Tab "ORMs" / "Prisma".
# Dort stehen beide Zeilen fertig zum Kopieren:
#   DATABASE_URL = Transaction Pooler (Port 6543) + ?pgbouncer=true — Laufzeit
#   DIRECT_URL   = Direct connection / Session Pooler (Port 5432)   — Migrationen
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DEIN_DB_PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DEIN_DB_PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (erst Phase 5) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lesify-local

# --- KI / Stripe / API (später) ---
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODE_ENV=development
PORT=3000
SESSION_SECRET=
