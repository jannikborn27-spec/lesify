# Vorlage. Pro Umgebung als .env anlegen (local) bzw. im Secret-Store von
# staging / production hinterlegen. Echte Werte NIE committen.
#
# local / staging / production haben jeweils EIGENE DB, EIGENEN Storage-Bucket
# und EIGENE Secrets.

# --- KI (Claude API) ---
ANTHROPIC_API_KEY=

# --- Datenbank: Supabase Postgres, EU-Region ---
# DATABASE_URL = Transaction Pooler (Port 6543, ?pgbouncer=true) — Laufzeit
# DIRECT_URL   = Direct/Session-Verbindung (Port 5432) — nur Migrationen
# Fertige Strings: Supabase-Dashboard → "Connect" → Tab "ORMs"/"Prisma".
# Für die API gehören diese Werte in api/.env (siehe api/.env.example).
DATABASE_URL=
DIRECT_URL=

# --- Supabase Storage (Datei-Uploads, signierte URLs) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lesify-local

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- API ---
NODE_ENV=development
PORT=3000
SESSION_SECRET=

# --- E-Mail: zurückgestellt (Phase 0 / backend-planning.md §8) ---
# EMAIL_API_KEY=
