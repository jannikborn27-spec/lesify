# api/.env  — lokale Werte, NIE committen (steht in .gitignore).
# Vorlage: cp api/.env.example api/.env  und [YOUR-PASSWORD] ersetzen.
#
# NICHT `npx prisma init` ausführen — Prisma ist unter api/prisma/ bereits
# eingerichtet. Nur diese Datei füllen und `pnpm --filter ./api db:migrate` laufen lassen.
#
# --- Datenbank (Supabase, Projekt sulfsxsihrqdhwvaacfx, eu-west-1) ---
# Werte aus: Supabase-Dashboard → "Connect" → Tab "ORMs".
#   DATABASE_URL = Transaction-Pooler (Port 6543) — Laufzeit
#   DIRECT_URL   = Session-Pooler   (Port 5432) — Migrationen
DATABASE_URL="postgresql://postgres.sulfsxsihrqdhwvaacfx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.sulfsxsihrqdhwvaacfx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (erst Phase 5) ---
SUPABASE_URL="https://sulfsxsihrqdhwvaacfx.supabase.co"
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lesify-local

# --- KI / Stripe / API (später) ---
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODE_ENV=development
PORT=3000
SESSION_SECRET=
